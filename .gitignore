# Whitelist: only the stareso workflow is tracked. Everything else in ~/.claude
# (credentials, sessions, projects, memory, settings) stays out of git.
/*
!/.gitignore
!/README.md
!/stareso/
!/stareso-app/
!/agents/
/agents/*
!/agents/stareso-slice-builder.md
!/agents/stareso-slice-checker.md
!/skills/
/skills/*
!/skills/stareso-*/
